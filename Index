                tab_calc: "Calculator",
                tab_conv: "Pressure",
                rwd_btn: "RWD (15% Loss)",
                fwd_btn: "FWD (12% Loss)",
                awd_btn: "AWD (20% Loss)",
                stock_block: "Stock Block Limit:",
                timing_recom: "Recommended Timing @ Max Boost:",
                cc_unit: "cc"
            }
        };

        let currentLang = 'ar';

        function toggleLanguage() {
            currentLang = currentLang === 'ar' ? 'en' : 'ar';
            document.documentElement.setAttribute('dir', currentLang === 'ar' ? 'rtl' : 'ltr');
            document.documentElement.setAttribute('lang', currentLang);
            document.getElementById('lang-btn-text').innerText = currentLang === 'ar' ? 'EN' : 'AR';
            
            // Translate static elements
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (translations[currentLang][key]) {
                    el.innerText = translations[currentLang][key];
                }
            });

            document.getElementById('engine-search').placeholder = translations[currentLang].search_engine_placeholder;
            
            // Re-render dynamic lists
            renderEngines();
            renderParts();
            calculateHp();
            updateAfrFromLambda(document.getElementById('lambda-slider').value);
        }

        // --- SECTION 1: AFR LOGIC ---
        let baseStoich = 14.7;
        let currentFuelName = 'gasoline';

        function setFuel(fuelKey, stoichVal) {
            baseStoich = stoichVal;
            currentFuelName = fuelKey;
            
            document.querySelectorAll('.fuel-btn').forEach(btn => {
                if(btn.getAttribute('data-fuel') === fuelKey) {
                    btn.className = "fuel-btn px-2 py-2 rounded-xl text-xs font-semibold bg-iosBlue text-white transition shadow-md";
                } else {
                    btn.className = "fuel-btn px-2 py-2 rounded-xl text-xs font-semibold ios-glass-sub text-gray-300 transition";
                }
            });

            document.getElementById('fuel-type-badge').innerText = fuelKey.toUpperCase();
            updateAfrFromLambda(document.getElementById('lambda-slider').value);
        }

        function updateAfrFromLambda(val) {
            const lambda = parseFloat(val);
            document.getElementById('lambda-val').innerText = lambda.toFixed(2);
            
            const afr = (lambda * baseStoich).toFixed(2);
            document.getElementById('res-afr').innerText = afr;

            const statusEl = document.getElementById('res-status');
            if (lambda > 1.02) {
                statusEl.innerText = currentLang === 'ar' ? 'وقود اقتصادي / كروز (Lean)' : 'Economical / Cruise (Lean)';
                statusEl.className = "text-xs font-bold text-yellow-400 mt-1.5 block";
            } else if (lambda >= 0.98 && lambda <= 1.02) {
                statusEl.innerText = currentLang === 'ar' ? 'احتراق مثالي Stoichiometric' : 'Stoichiometric Combustion';
                statusEl.className = "text-xs font-bold text-iosGreen mt-1.5 block";
            } else if (lambda >= 0.82) {
                statusEl.innerText = currentLang === 'ar' ? 'قدرة عالية طبيعية (NA Power)' : 'Naturally Aspirated Power';
                statusEl.className = "text-xs font-bold text-iosBlue mt-1.5 block";
            } else {
                statusEl.innerText = currentLang === 'ar' ? 'احتراق توربو آمن تحت البوست (Rich Boost)' : 'Safe Turbo Boost Combustion';
                statusEl.className = "text-xs font-bold text-iosOrange mt-1.5 block";
            }
        }

        // --- SECTION 2: ENGINES DATABASE ---
        const enginesData = [
            { id: '2jz', name: 'Toyota 2JZ-GTE / VVTi', disp: '3.0L Turbo', stockHp: '320 HP', stockLimit: '600 - 650 HP (Stock Block)', timing: '11° - 14° BTDC @ 1.5 Bar', desc: 'أشهر محرك ستاند ألون في العالم، يتحمل عزم هائل على البساتن الأصلية.' },
            { id: 'rb26', name: 'Nissan RB26DETT', disp: '2.6L Twin Turbo', stockHp: '276 HP', stockLimit: '550 - 600 HP (Stock Block)', timing: '12° - 15° BTDC @ 1.4 Bar', desc: 'أسطورة النيسان سكايلاين، رباعي الكامات مع نظام تبريد وفوهة زيت قوية.' },
            { id: 'ls3', name: 'GM LS3 V8 Small Block', disp: '6.2L V8 NA / SC', stockHp: '430 HP', stockLimit: '650 - 700 HP (Stock Block)', timing: '15° - 18° BTDC @ Supercharged', desc: 'عزم دوران جبار، استجابة بستم فورجي جاهز للتعديل المفتوح.' },
            { id: 'ej25', name: 'Subaru EJ257 / STI', disp: '2.5L Boxer Turbo', stockHp: '300 HP', stockLimit: '380 - 420 HP (Stock Block)', timing: '10° - 13° BTDC @ 1.2 Bar', desc: 'محرك بوكسر قوي، يتطلب عناية فائقة بدرجات حرارة الزيت وضغط البوست.' },
            { id: 'k24', name: 'Honda K24 / K20 Turbo', disp: '2.4L VTEC Turbo', stockHp: '200 HP', stockLimit: '500 - 550 HP (Stock Block)', timing: '13° - 16° BTDC @ 1.4 Bar', desc: 'ملك الهوندا المعتمد في السرعة والتحمل العالي مع كمبيوتر ستاند ألون.' },
            { id: '4g63', name: 'Mitsubishi 4G63T Evo 8/9', disp: '2.0L Turbo', stockHp: '280 HP', stockLimit: '500 - 580 HP (Stock Block)', timing: '12° - 15° BTDC @ 1.5 Bar', desc: 'بستم حديدي قوي وقدرة جبارة على تحمل الضغط العالي بدون تعديل السلندر.' },
            { id: 'b58', name: 'BMW B58 Single Turbo', disp: '3.0L Turbo', stockHp: '382 HP', stockLimit: '600 - 650 HP (Stock DME/Unlock)', timing: '14° - 17° BTDC @ 1.8 Bar', desc: 'الجيل الحديث القوي جداً، نظام حقن مباشر ممتاز.' }
        ];

        function renderEngines(filter = '') {
            const container = document.getElementById('engines-list');
            container.innerHTML = '';
            
            const filtered = enginesData.filter(e => e.name.toLowerCase().includes(filter.toLowerCase()));
            
            filtered.forEach(eng => {
                container.innerHTML += `
                    <div class="ios-glass-sub p-4 rounded-xl space-y-2 border border-gray-800">
                        <div class="flex justify-between items-start">
                            <div>
                                <h3 class="font-bold text-sm text-white">${eng.name}</h3>
                                <span class="text-[11px] text-iosBlue font-mono-num">${eng.disp} • Stock: ${eng.stockHp}</span>
                            </div>
                            <span class="text-[10px] bg-black/40 px-2 py-1 rounded-lg text-gray-300 font-mono-num">${eng.stockLimit.split(' ')[0]} HP</span>
                        </div>
                        <p class="text-xs text-gray-400">${eng.desc}</p>
                        <div class="grid grid-cols-2 gap-2 pt-2 border-t border-gray-800 text-[11px]">
                            <div><span class="text-gray-500 block">${translations[currentLang].stock_block}</span> <span class="text-gray-200 font-bold">${eng.stockLimit}</span></div>
                            <div><span class="text-gray-500 block">${translations[currentLang].timing_recom}</span> <span class="text-iosGreen font-bold">${eng.timing}</span></div>
                        </div>
                    </div>
                `;
            });
        }

        function filterEngines(val) {
            renderEngines(val);
        }

        // --- SECTION 3: CALCULATOR LOGIC ---
        let currentBoostBar = 1.5;
        let drivetrainLoss = 15; // RWD 15%

        const tuningParts = [
            { id: 'turbo', name: 'توربو أكبر / كاستم (Big Turbo Upgrade)', hpAdd: 180 },
            { id: 'injectors', name: 'بخاخات عالية التدفق 1000cc+ & طرمبة بنزين', hpAdd: 50 },
            { id: 'intercooler', name: 'إنتركولر كبير + أنابيب ضغط ألومنيوم', hpAdd: 35 },
            { id: 'cams', name: 'كام شافت رياضي (Sport Camshafts)', hpAdd: 40 },
            { id: 'exhaust', name: 'نظام إكزوست كامل كاستم 3 بوصة', hpAdd: 30 },
            { id: 'manifold', name: 'ثلاجة محرك رياضية + ثروتل كبير', hpAdd: 25 },
            { id: 'e85', name: 'وقود إيثانول E85 مع حساس Flex Fuel', hpAdd: 70 },
            { id: 'ecu', name: 'كمبيوتر ستاند ألون (Standalone ECU Tune)', hpAdd: 60 }
        ];

        function renderParts() {
            const container = document.getElementById('parts-container');
            container.innerHTML = '';
            tuningParts.forEach((part, idx) => {
                container.innerHTML += `
                    <label class="ios-glass-sub p-2.5 rounded-xl flex items-center space-x-2 space-x-reverse cursor-pointer hover:bg-gray-800/50 transition">
                        <input type="checkbox" id="part-${idx}" value="${part.hpAdd}" onchange="calculateHp()" class="w-4 h-4 rounded accent-iosBlue">
                        <span class="text-xs text-gray-200">${part.name}</span>
                    </label>
                `;
            });
        }

        function updateBoostFromSlider(val) {
            currentBoostBar = (val / 10).toFixed(1);
            document.getElementById('boost-num-input').value = currentBoostBar;
            document.getElementById('boost-unit-label').innerText = `Bar (~${(currentBoostBar * 14.5038).toFixed(1)} PSI)`;
            calculateHp();
        }

        function updateBoostFromNum(val) {
            let num = parseFloat(val);
            if (isNaN(num)) num = 0;
            if (num > 3.5) num = 3.5;
            currentBoostBar = num;
            document.getElementById('boost-slider').value = Math.round(num * 10);
            document.getElementById('boost-unit-label').innerText = `Bar (~${(num * 14.5038).toFixed(1)} PSI)`;
            calculateHp();
        }

        function setDrivetrain(type, loss) {
            drivetrainLoss = loss;
            document.querySelectorAll('.dt-btn').forEach(btn => {
                if(btn.getAttribute('data-dt') === type) {
                    btn.className = "dt-btn px-2 py-2 rounded-xl text-xs font-semibold bg-iosBlue text-white transition";
                } else {
                    btn.className = "dt-btn px-2 py-2 rounded-xl text-xs font-semibold ios-glass-sub text-gray-300 transition";
                }
            });
            calculateHp();
        }

        function calculateHp() {
            const engineType = document.getElementById('calc-engine-select').value;
            let baseCrank = 300;
            let stockPistonLimit = 600;

            if (engineType === '2jz') { baseCrank = 320; stockPistonLimit = 650; }
            else if (engineType === 'rb26') { baseCrank = 280; stockPistonLimit = 600; }
            else if (engineType === 'ls3') { baseCrank = 430; stockPistonLimit = 700; }
            else if (engineType === 'ej25') { baseCrank = 300; stockPistonLimit = 420; }
            else if (engineType === 'k24') { baseCrank = 210; stockPistonLimit = 500; }
            else if (engineType === '4g63') { baseCrank = 280; stockPistonLimit = 550; }
            else if (engineType === 'b58') { baseCrank = 382; stockPistonLimit = 650; }

            // Calculate parts bonus
            let partsBonus = 0;
            tuningParts.forEach((part, idx) => {
                const chk = document.getElementById(`part-${idx}`);
                if (chk && chk.checked) {
                    partsBonus += part.hpAdd;
                }
            });

            // Realistic Boost multiplier (Volumetric Efficiency & PR)
            // 1.5 Bar boost adds substantial realistic power mapped properly
            let boostMultiplier = 1 + (currentBoostBar * 0.42);
            
            let totalCrankHp = Math.round((baseCrank + partsBonus) * boostMultiplier);
            
            // Apply drivetrain loss for Wheel HP (WHP)
            let wheelHp = Math.round(totalCrankHp * (1 - (drivetrainLoss / 100)));

            document.getElementById('res-crank-hp').innerText = totalCrankHp + " HP";
            document.getElementById('res-wheel-hp').innerText = wheelHp + " WHP";

            const alertEl = document.getElementById('engine-safety-alert');
            if (totalCrankHp > stockPistonLimit) {
                alertEl.innerHTML = `<i class="fa-solid fa-triangle-exclamation ml-1"></i> ${translations[currentLang].warning_limit}`;
                alertEl.className = "mt-3 pt-3 border-t border-gray-800 text-center text-xs font-semibold text-iosRed";
            } else {
                alertEl.innerHTML = `<i class="fa-solid fa-circle-check ml-1"></i> ${translations[currentLang].safe_limit}`;
                alertEl.className = "mt-3 pt-3 border-t border-gray-800 text-center text-xs font-semibold text-iosGreen";
            }
        }

        // --- SECTION 4: CONVERTER LOGIC ---
        function convertFrom(unit, val) {
            let v = parseFloat(val);
            if (isNaN(v)) {
                document.getElementById('conv-psi').value = '';
                document.getElementById('conv-bar').value = '';
                document.getElementById('conv-kpa').value = '';
                return;
            }

            let psi = 0, bar = 0, kpa = 0;

            if (unit === 'psi') {
                psi = v;
                bar = v / 14.5038;
                kpa = v * 6.89476;
            } else if (unit === 'bar') {
                bar = v;
                psi = v * 14.5038;
                kpa = v * 100;
            } else if (unit === 'kpa') {
                kpa = v;
                bar = v / 100;
                psi = v / 6.89476;
            }

            if (unit !== 'psi') document.getElementById('conv-psi').value = psi.toFixed(2);
            if (unit !== 'bar') document.getElementById('conv-bar').value = bar.toFixed(2);
            if (unit !== 'kpa') document.getElementById('conv-kpa').value = kpa.toFixed(1);
        }

        // --- NAVIGATION TABS SWITCHER ---
        function switchTab(tabId) {
            const sections = ['afr', 'engines', 'calculator', 'converter'];
            sections.forEach(s => {
                const el = document.getElementById(`section-${s}`);
                if (s === tabId) {
                    el.classList.remove('hidden');
                } else {
                    el.classList.add('hidden');
                }
            });

            document.querySelectorAll('.nav-tab').forEach(btn => {
                btn.className = "nav-tab flex flex-col items-center justify-center py-1.5 text-gray-400 hover:text-gray-200 transition";
            });

            const activeBtn = document.getElementById(`nav-btn-${tabId}`);
            if(activeBtn) {
                activeBtn.className = "nav-tab flex flex-col items-center justify-center py-1.5 text-iosBlue transition";
            }

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Initialization on load
        window.onload = function() {
            renderEngines();
            renderParts();
            calculateHp();
            updateAfrFromLambda(0.85);
        };
    </script>
</body>
</html>
